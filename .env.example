# Variables del stack Docker (docker-compose.yml).
#
# Cópialo a `.env` en la raíz del repositorio (está en .gitignore). Solo lo lee
# docker compose; el backend sin Docker usa backend/.env (ver backend/.env.example
# y SETUP.md).
#
# Todo lo de aquí es local: no pongas valores de producción.

# ── Obligatorias: sin ellas `docker compose up` se niega a arrancar ──────────
# Genera cada una (distintas entre sí) con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
NULLIFIER_SECRET=

# ── Para poder sembrar los datos de demostración ─────────────────────────────
# Al menos 12 caracteres cada una. Genera cada una con:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=
SEED_DEMO_SUPERADMIN_PASSWORD=
SEED_DEMO_STUDENT_PASSWORD=

# Botón «Demo» de la portada. Déjalo en false si el puerto 3000 va a quedar
# accesible desde fuera de tu máquina.
DEMO_LOGIN_ENABLED=true

# ── Opcionales, pero sin una cadena no se puede votar (503 ELECTION_NOT_ON_CHAIN) ──
# RPC_URL=
# CONTRACT_ADDRESS=
# DEPLOY_BLOCK=
# PRIVATE_KEY=
# EXPLORER_URL=
