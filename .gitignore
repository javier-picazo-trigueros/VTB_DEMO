# Cualquier variante de .env en cualquier carpeta: copias de seguridad
# (.env.bak-*, .env.backup), entornos (.env.staging), etc. Las plantillas
# .env.example sí se versionan. Ojo: frontend/.env.production ya estaba
# rastreado antes de esta regla, y una regla de ignore no saca del índice un
# fichero rastreado; eso requiere `git rm --cached`.
.env.*
!.env.example

# Registros de despliegue en cadenas locales: ruido, cambian en cada
# `npm run deploy:local` y no sirven a nadie fuera de tu maquina.
# El de las redes reales (sepolia.json) SI se versiona: RECUENTO_INDEPENDIENTE.md
# le dice a un tercero que ahi encontrara la direccion del contrato.
blockchain/deployments/localhost.json
blockchain/deployments/hardhat.json
