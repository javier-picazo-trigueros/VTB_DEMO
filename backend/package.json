{
    "name": "vtb-backend",
    "version": "1.0.0",
    "type": "module",
    "description": "VTB Backend - Express + SQLite + Web3 Relayer",
    "main": "src/index.ts",
    "scripts": {
        "start": "tsx src/index.ts",
        "dev": "nodemon --exec tsx src/index.ts",
        "build": "tsc",
        "seed": "tsx src/scripts/seedDatabase.ts",
        "sync-blockchain": "node --loader ts-node/esm src/scripts/syncElections.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write src",
        "test": "vitest run",
        "test:watch": "vitest",
        "migrate": "node-pg-migrate up",
        "migrate:down": "node-pg-migrate down 1",
        "migrate:status": "node-pg-migrate status",
        "migrate:create": "node-pg-migrate create",
        "db:migrate": "tsx scripts/migrate-sqlite-to-pg.ts",
        "db:rollback": "tsx scripts/rollback-pg-to-sqlite.ts",
        "rotate-admin-passwords": "tsx scripts/rotate-weak-admin-passwords.ts"
    },
    "node-pg-migrate": {
        "migrations-dir": "migrations"
    },
    "keywords": [
        "backend",
        "express",
        "sqlite",
        "web3",
        "ethereum",
        "blockchain"
    ],
    "author": "Senior Web3 Architect",
    "license": "MIT",
    "dependencies": {
        "@types/multer": "^2.1.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-parse": "^7.0.2",
        "dotenv": "^17.3.1",
        "ethers": "^6.11.1",
        "express": "^4.22.2",
        "express-rate-limit": "^7.5.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.1.1",
        "node-pg-migrate": "^7.9.1",
        "pg": "^8.22.0",
        "resend": "^6.18.1",
        "sqlite3": "^6.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/express-rate-limit": "^5.1.3",
        "@types/helmet": "^0.0.48",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.10.6",
        "@types/pg": "^8.21.0",
        "@types/supertest": "^7.2.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "nodemon": "^3.0.2",
        "prettier": "^3.9.6",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.11",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.5"
    },
    "overrides": {
        "ws": ">=8.17.1"
    }
}
